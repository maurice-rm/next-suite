{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**", "out/**"]
    },
    "check-types": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "boundaries": {
    "tags": {
      "published": {
        "dependencies": {
          "deny": ["internal", "app"]
        }
      },
      "config": {
        "dependencies": {
          "deny": ["published", "internal", "app"]
        }
      },
      "app": {
        "dependents": {
          "deny": ["published", "internal", "config", "app"]
        }
      }
    }
  }
}
