{
  "name": "next-suite",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "cli": "pnpm --filter create-next-suite build && node packages/cli/dist/index.js",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "catalog:",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "^2.10.12",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  }
}
