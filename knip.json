{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/create-next-suite": {
      "entry": ["plugins/*/*/plugin.ts"],
      "ignore": ["base/**", "plugins/*/*/files/**"],
      "vitest": {
        "entry": ["src/**/*.test.ts", "src/**/*.test-d.ts"]
      }
    },
    "packages/integration": {
      "entry": ["scripts/*.ts", "fixtures/plugins/*/plugin.ts"],
      "ignore": ["fixtures/plugins/*/files/**"]
    }
  }
}
