{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!packages/create-next-suite/plugins/*/*/files",
      "!packages/create-next-suite/base/files"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 3
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "performance": {
        "noReExportAll": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        },
        "useNamingConvention": {
          "level": "error",
          "options": {
            "strictCase": false,
            "conventions": [
              {
                "selector": {
                  "kind": "objectLiteralProperty"
                },
                "formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                "formats": ["camelCase", "PascalCase"]
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/create-next-suite/src/contract/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/answers",
                      "**/answers/**",
                      "**/loader",
                      "**/loader/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: contract/ is the innermost module and imports no other"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/answers/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/loader",
                      "**/loader/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: answers/ imports only from contract/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/loader/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/answers",
                      "**/answers/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: loader/ imports only from contract/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/compose/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: compose/ imports from contract/, answers/ and loader/ only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/compose/template/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "../*.ts",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: compose/template/ imports from contract/, answers/ and loader/ only, never from compose/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/write/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: write/ imports from compose/ and inner modules only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/questions/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: questions/ imports from contract/, answers/, loader/ and ui/ only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/post-steps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/answers",
                      "**/answers/**",
                      "**/loader",
                      "**/loader/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: post-steps/ imports only from contract/"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/trust",
                      "**/trust/**",
                      "**/contract",
                      "**/contract/**",
                      "**/answers",
                      "**/answers/**",
                      "**/loader",
                      "**/loader/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: ui/ renders only and imports no other module"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/trust/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/answers",
                      "**/answers/**",
                      "**/compose",
                      "**/compose/**",
                      "**/write",
                      "**/write/**",
                      "**/questions",
                      "**/questions/**",
                      "**/post-steps",
                      "**/post-steps/**",
                      "**/ui",
                      "**/ui/**",
                      "**/cli",
                      "**/cli/**",
                      "**/create-next-suite.ts",
                      "**/next-suite.ts",
                      "**/plugin.ts"
                    ],
                    "message": "create-next-suite: trust/ imports from contract/ and loader/ only"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/create-next-suite/src/cli/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/create-next-suite.ts", "**/next-suite.ts", "**/plugin.ts"],
                    "message": "create-next-suite: cli/ never imports the package entries"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
