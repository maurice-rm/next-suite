{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "schedule:weekly"],
  "minimumReleaseAge": "1 day",
  "timezone": "Europe/Berlin",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "groupName": "github actions"
    },
    {
      "matchFileNames": [
        "packages/create-next-suite/plugins-v2/*/*/plugin.ts",
        "packages/create-next-suite/base-project/package.json"
      ],
      "groupName": "built-in versions"
    },
    {
      "description": "@types/node of generated projects stays on the Node.js major their CI runs, the one create-next-suite's engines name",
      "matchFileNames": ["packages/create-next-suite/base-project/package.json"],
      "matchDepNames": ["@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "description": "The Bun version CI installs follows the one generated projects pin",
      "matchDepNames": ["bun"],
      "groupName": "bun"
    }
  ],
  "customManagers": [
    {
      "description": "The versions of the built-in plugins: each entry of their VERSIONS constant, keyed by its npm package",
      "customType": "regex",
      "managerFilePatterns": ["/^packages/create-next-suite/plugins-v2/[^/]+/[^/]+/plugin\\.ts$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "const VERSIONS = \\{[^}]*\\}",
        "'?(?<depName>[@a-z0-9][\\w@./-]*)'?: '(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "description": "The Bun version the workflows install",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.yml$/"],
      "matchStrings": ["bun-version: (?<currentValue>\\S+)"],
      "depNameTemplate": "bun",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
