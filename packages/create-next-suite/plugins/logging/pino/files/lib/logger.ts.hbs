import type { Instrumentation } from "next";
import pino from "pino";
{{#if (has "plugin:t3-env")}}

import { env } from "{{project.importPrefix}}env";

const level = env.LOG_LEVEL;
{{/if}}
{{#unless (has "plugin:t3-env")}}

const level = process.env.LOG_LEVEL ?? "info";
{{/unless}}

export const logger = pino({
  level,
  redact: [
{{#each logRedact}}
    "{{this}}",
{{/each}}
  ],
});

export const reportRequestError: Instrumentation.onRequestError = (error, request, context) => {
  logger.error(
    { err: error, path: request.path, method: request.method, ...context },
    "request failed",
  );
};
