{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "pino",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "Logging with pino",
  "description": "Logs with pino and reports server errors through instrumentation.ts.",
  "category": "logging",
  "dependencies": {
    "pino": "catalog:pino"
  },
  "env": [
    {
      "name": "LOG_LEVEL",
      "scope": "server",
      "secret": false,
      "example": "info",
      "default": "info",
      "description": "The lowest level pino logs: trace, debug, info, warn, error or fatal."
    }
  ],
  "contributes": {
    "instrumentation": {
      "onRequestError": [
        {
          "module": "#src/lib/logger",
          "export": "reportRequestError"
        }
      ]
    },
    "logRedact": ["req.headers.authorization", "req.headers.cookie"],
    "stack": ["pino"]
  },
  "files": [
    {
      "source": "files/lib/logger.ts.hbs",
      "target": "lib/logger.ts",
      "root": "source"
    }
  ]
}
