{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "eslint",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "ESLint",
  "description": "Lints with ESLint 9 and the Next.js rules for Core Web Vitals and TypeScript.",
  "category": "linter",
  "devDependencies": {
    "eslint": "catalog:eslint",
    "eslint-config-next": "catalog:eslint-config-next"
  },
  "contributes": {
    "package": {
      "scripts": {
        "lint": "eslint"
      }
    },
    "lintStaged": [
      {
        "glob": "*.{js,jsx,mjs,cjs,ts,tsx}",
        "command": "eslint --fix"
      }
    ],
    "ciChecks": ["lint"],
    "stack": ["ESLint"],
    "deniedBuilds": ["unrs-resolver"]
  },
  "files": [
    {
      "source": "files/eslint.config.mjs.hbs",
      "target": "eslint.config.mjs"
    }
  ]
}
