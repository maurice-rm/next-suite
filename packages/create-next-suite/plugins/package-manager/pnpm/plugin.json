{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "pnpm",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "pnpm",
  "description": "Installs with pnpm, takes new releases after a day and runs only allowed dependency builds.",
  "category": "package-manager",
  "packageManager": {
    "version": "catalog:pnpm",
    "ciInstallArgs": ["install", "--frozen-lockfile"],
    "whenVersionDiffers": "download",
    "allowedBuildsIn": "pnpm-workspace.yaml"
  },
  "files": [{ "source": "files/pnpm-workspace.yaml.hbs", "target": "pnpm-workspace.yaml" }]
}
