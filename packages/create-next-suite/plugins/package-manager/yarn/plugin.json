{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "yarn",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "Yarn",
  "description": "Installs with Yarn 4 into node_modules, takes new releases after a day and runs only allowed dependency builds.",
  "category": "package-manager",
  "packageManager": {
    "version": "catalog:yarn",
    "installArgs": ["install", "--no-immutable"],
    "ciInstallArgs": ["install", "--immutable"],
    "whenVersionDiffers": "warn",
    "allowedBuildsIn": "package.json#dependenciesMeta"
  },
  "files": [
    {
      "source": "files/yarnrc.yml",
      "target": ".yarnrc.yml"
    }
  ],
  "contributes": {
    "gitignore": [
      ".yarn/*",
      "!.yarn/patches",
      "!.yarn/plugins",
      "!.yarn/releases",
      "!.yarn/sdks",
      "!.yarn/versions"
    ]
  }
}
