{
  "$schema": "../../../generated/schemas/plugin.json",
  "name": "bun",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "Bun",
  "description": "Installs with Bun, takes new releases after a day and runs only the dependency builds this project allows.",
  "category": "package-manager",
  "packageManager": {
    "version": "catalog:bun",
    "ciInstallArgs": ["install", "--frozen-lockfile"],
    "whenVersionDiffers": "warn",
    "allowedBuildsIn": "package.json#trustedDependencies"
  },
  "files": [{ "source": "files/bunfig.toml", "target": "bunfig.toml" }]
}
