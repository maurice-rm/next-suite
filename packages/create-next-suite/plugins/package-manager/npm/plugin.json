{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "npm",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "npm",
  "description": "Installs with npm, takes new releases after a day and fails on dependency builds that are not allowed.",
  "category": "package-manager",
  "packageManager": {
    "version": "catalog:npm",
    "ciInstallArgs": ["ci"],
    "whenVersionDiffers": "warn",
    "allowedBuildsIn": "package.json#allowScripts"
  },
  "files": [{ "source": "files/npmrc", "target": ".npmrc" }]
}
