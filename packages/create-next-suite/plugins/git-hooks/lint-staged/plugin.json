{
  "$schema": "../../../generated/schemas/plugin.json",
  "name": "lint-staged",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "lint-staged with Husky",
  "description": "Lints and formats the staged files before each commit, through a Husky pre-commit hook.",
  "category": "git-hooks",
  "requires": [
    {
      "when": {
        "any": [
          {
            "category": "linter"
          },
          {
            "category": "formatter"
          }
        ]
      },
      "reason": "It runs the linter or the formatter on the staged files."
    }
  ],
  "devDependencies": {
    "husky": "catalog:husky",
    "lint-staged": "catalog:lint-staged"
  },
  "contributes": {
    "package": {
      "scripts": {
        "prepare": "husky"
      }
    },
    "stack": ["Husky"]
  },
  "postSteps": [
    {
      "script": "prepare",
      "running": "Setting up Git hooks",
      "done": "Set up Git hooks",
      "when": {
        "setting": "git",
        "equals": true
      }
    }
  ],
  "files": [
    {
      "source": "files/lint-staged.config.mjs.hbs",
      "target": "lint-staged.config.mjs"
    },
    {
      "source": "files/husky/pre-commit",
      "target": ".husky/pre-commit"
    }
  ]
}
