{
  "$schema": "../../../generated/schemas/plugin.json",
  "name": "static-csp",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "Security headers",
  "description": "Sends a static Content Security Policy and the common security headers.",
  "category": "security-headers",
  "contributes": {
    "csp": {
      "default-src": ["'self'"],
      "script-src": ["'self'", "'unsafe-inline'"],
      "style-src": ["'self'", "'unsafe-inline'"],
      "img-src": ["'self'", "blob:", "data:"],
      "font-src": ["'self'"],
      "object-src": ["'none'"],
      "base-uri": ["'self'"],
      "form-action": ["'self'"],
      "frame-ancestors": ["'none'"],
      "upgrade-insecure-requests": []
    },
    "nextConfig": {
      "imports": ["import { securityHeaders } from \"./security-headers\";"],
      "options": [
        {
          "key": "headers",
          "value": "async () => [{ source: \"/(.*)\", headers: securityHeaders }]"
        }
      ]
    },
    "readme": [
      {
        "section": "Security headers",
        "text": "`security-headers.ts` sets a static Content Security Policy and the common security headers for every route. HSTS leaves out `includeSubDomains`, so subdomains keep plain HTTP until you opt in."
      }
    ]
  },
  "files": [
    {
      "source": "files/security-headers.ts.hbs",
      "target": "security-headers.ts"
    }
  ]
}
