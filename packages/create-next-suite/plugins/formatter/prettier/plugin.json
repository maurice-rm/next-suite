{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "prettier",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "Prettier",
  "description": "Formats with Prettier.",
  "category": "formatter",
  "conflicts": [{ "when": { "plugin": "biome" }, "reason": "Biome formats the code already." }],
  "devDependencies": { "prettier": "catalog:prettier" },
  "contributes": {
    "package": {
      "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check ."
      }
    },
    "lintStaged": [{ "glob": "*", "command": "prettier --write --ignore-unknown" }],
    "ciChecks": ["format:check"],
    "stack": ["Prettier"]
  },
  "postSteps": [{ "script": "format", "running": "Formatting files", "done": "Formatted files" }],
  "files": [
    { "source": "files/prettier.config.mjs.hbs", "target": "prettier.config.mjs" },
    { "source": "files/prettierignore", "target": ".prettierignore" }
  ]
}
