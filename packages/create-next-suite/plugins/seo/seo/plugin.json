{
  "$schema": "../../../dist/schemas/plugin.json",
  "name": "seo",
  "version": "1.0.0",
  "contract": "^1.0.0",
  "title": "SEO",
  "description": "Adds robots.txt, a sitemap and the site URL for metadata.",
  "category": "seo",
  "env": [
    {
      "name": "NEXT_PUBLIC_SITE_URL",
      "scope": "client",
      "secret": false,
      "example": "http://localhost:3000",
      "default": "http://localhost:3000",
      "description": "The public URL of the site, for absolute links in metadata, robots.txt and the sitemap."
    }
  ],
  "contributes": {
    "layoutMetadata": [
      {
        "key": "metadataBase",
        "value": "new URL(process.env.NEXT_PUBLIC_SITE_URL || \"http://localhost:3000\")"
      }
    ]
  },
  "files": [
    {
      "source": "files/lib/site-url.ts.hbs",
      "target": "lib/site-url.ts",
      "root": "source"
    },
    {
      "source": "files/app/robots.ts.hbs",
      "target": "app/robots.ts",
      "root": "source"
    },
    {
      "source": "files/app/sitemap.ts.hbs",
      "target": "app/sitemap.ts",
      "root": "source"
    }
  ]
}
