import { createEnv } from "@t3-oss/env-nextjs";
import * as z from "zod";

export const env = createEnv({
  server: {
{{#each env.server}}
    {{key}}: {{value}},
{{/each}}
  },
  client: {
{{#each env.client}}
    {{key}}: {{value}},
{{/each}}
  },
  experimental__runtimeEnv: {
{{#each env.client}}
    {{key}}: process.env.{{key}},
{{/each}}
  },
  emptyStringAsUndefined: true,
});
