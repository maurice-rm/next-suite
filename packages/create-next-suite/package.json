{
  "name": "create-next-suite",
  "version": "0.0.0",
  "description": "Scaffold a Next.js app from plugins: pick a package manager, linter, styling, database, auth and more, or bring your own.",
  "keywords": [
    "next",
    "nextjs",
    "create-next-app",
    "scaffold",
    "template",
    "cli",
    "plugins"
  ],
  "license": "MIT",
  "author": "Maurice Reim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurice-rm/next-suite.git",
    "directory": "packages/create-next-suite"
  },
  "bugs": "https://github.com/maurice-rm/next-suite/issues",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "files": [
    "dist",
    "base",
    "plugins"
  ],
  "bin": {
    "create-next-suite": "./dist/create-next-suite.mjs",
    "next-suite": "./dist/next-suite.mjs"
  },
  "exports": {
    "./config": "./dist/config.mjs",
    "./plugin": "./dist/plugin.mjs",
    "./testing": "./dist/testing.mjs",
    "./schemas/registry.json": "./dist/schemas/registry.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/write-json-schemas.ts && tsdown",
    "check-types": "tsc",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.only"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@next-suite/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/semver": "7.8.0",
    "publint": "0.3.25",
    "tsdown": "0.23.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "ansis": "4.4.0",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "jiti": "2.7.0",
    "magic-string": "1.4.5",
    "oxc-parser": "0.156.0",
    "semver": "7.8.5",
    "tar": "7.5.22",
    "validate-npm-package-name": "8.0.0",
    "zod": "4.6.7"
  }
}
