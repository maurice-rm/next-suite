import "server-only";

import { Resend } from "resend";

import { env } from "@/env";

export const EMAIL_FROM = env.EMAIL_FROM;

let resend: Resend | undefined;

// Created on first use: constructing it at import breaks builds without
// secrets (e.g. Docker builds running with SKIP_ENV_VALIDATION).
export const getResend = (): Resend =>
  (resend ??= new Resend(env.RESEND_API_KEY));
