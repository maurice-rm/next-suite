minimumReleaseAge: 1440
allowBuilds:
{{#if (eq database.orm "prisma")}}
  "@prisma/engines": true
{{/if}}
  esbuild: true
{{#if (eq database.orm "prisma")}}
  prisma: true
{{/if}}
  sharp: true
  unrs-resolver: true
auditConfig:
  ignoreGhsas:
{{#each (acceptedAdvisories)}}
    - {{this}}
{{/each}}
{{#each (dependencyOverrides)}}
{{#if @first}}
overrides:
{{/if}}
  "{{name}}": "{{version}}"
{{/each}}
