import { toast } from "sonner";

import {
  type ErrorMessages,
  toErrorMessage,
} from "@/lib/errors/display/error-messages";

const ERROR_TOAST_DURATION_MS = 10_000;

export const showErrorToast = (error: unknown, overrides?: ErrorMessages) =>
  toast.error(toErrorMessage(error, overrides), {
    duration: ERROR_TOAST_DURATION_MS,
  });
