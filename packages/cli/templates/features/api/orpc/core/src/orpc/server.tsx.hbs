import "server-only";

import { cache, type ReactNode } from "react";

import {
  dehydrate,
  HydrationBoundary,
  type InfiniteQueryExecuteOptions,
  noop,
  type QueryExecuteOptions,
  type QueryKey,
} from "@tanstack/react-query";

import { createQueryClient } from "@/orpc/query-client";

export const getQueryClient = cache(createQueryClient);

type HydrateClientProps = { children: ReactNode };

export const HydrateClient = ({ children }: HydrateClientProps) => {
  const state = dehydrate(getQueryClient());
  return <HydrationBoundary state={state}>{children}</HydrationBoundary>;
};

export const prefetch = <
  TQueryFnData,
  TError,
  TData,
  TQueryData,
  TQueryKey extends QueryKey,
>(
  options: QueryExecuteOptions<
    TQueryFnData,
    TError,
    TData,
    TQueryData,
    TQueryKey
  >,
) => {
  getQueryClient().query(options).catch(noop);
};

export const prefetchInfinite = <
  TQueryFnData,
  TError,
  TData,
  TQueryKey extends QueryKey,
  TPageParam,
>(
  options: InfiniteQueryExecuteOptions<
    TQueryFnData,
    TError,
    TData,
    TQueryKey,
    TPageParam
  >,
) => {
  getQueryClient().infiniteQuery(options).catch(noop);
};
