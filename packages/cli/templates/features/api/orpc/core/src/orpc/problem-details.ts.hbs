import { STATUS_CODES } from "node:http";

import { commonErrors } from "@/lib/errors/common-errors";

export const PROBLEM_CONTENT_TYPE = "application/problem+json";

export type ProblemDetails = {
  type: string;
  title: string;
  status: number;
  detail: string;
  code: string;
  data?: unknown;
};

export const notFoundResponse = () => {
  const { code, status } = commonErrors.create("NOT_FOUND");
  return Response.json(
    {
      type: "about:blank",
      title: STATUS_CODES[status] ?? code,
      status,
      detail: "No operation matches this path and method.",
      code,
    } satisfies ProblemDetails,
    { status, headers: { "Content-Type": PROBLEM_CONTENT_TYPE } },
  );
};
