import { onError } from "@orpc/server";
import { RPCHandler } from "@orpc/server/fetch";

import { RPC_ENDPOINT } from "@/orpc/endpoint";
import { logRequestError } from "@/orpc/log-request-error";
import { notFoundResponse } from "@/orpc/problem-details";
import { appRouter } from "@/orpc/routers/app-router";

const handler = new RPCHandler(appRouter, {
  interceptors: [onError(logRequestError)],
});

const handleRequest = async (request: Request) => {
  const { response } = await handler.handle(request, {
    prefix: RPC_ENDPOINT,
    context: { headers: request.headers },
  });

  return response ?? notFoundResponse();
};

export {
  handleRequest as DELETE,
  handleRequest as GET,
  handleRequest as HEAD,
  handleRequest as PATCH,
  handleRequest as POST,
  handleRequest as PUT,
};
