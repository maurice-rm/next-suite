import { StandardRPCJsonSerializer } from "@orpc/client/standard";
import {
  defaultShouldDehydrateQuery,
  QueryClient,
} from "@tanstack/react-query";

// Serializes oRPC types (Date, Map, …) across query keys and (de)hydration.
const serializer = new StandardRPCJsonSerializer();

type DehydratedData = {
  json: unknown;
  meta: ReturnType<StandardRPCJsonSerializer["serialize"]>[1];
};

const STALE_TIME_MS = 300_000;
const GARBAGE_COLLECTION_TIME_MS = 600_000;

export const createQueryClient = () =>
  new QueryClient({
    defaultOptions: {
      queries: {
        queryKeyHashFn: (queryKey) => {
          const [json, meta] = serializer.serialize(queryKey);
          return JSON.stringify({ json, meta });
        },
        staleTime: STALE_TIME_MS,
        gcTime: GARBAGE_COLLECTION_TIME_MS,
        refetchOnWindowFocus: false,
      },
      dehydrate: {
        shouldDehydrateQuery: (query) =>
          defaultShouldDehydrateQuery(query) ||
          query.state.status === "pending",
        shouldRedactErrors: () => false,
        serializeData: (data): DehydratedData => {
          const [json, meta] = serializer.serialize(data);
          return { json, meta };
        },
      },
      hydrate: {
        deserializeData: (data: DehydratedData) =>
          serializer.deserialize(data.json, data.meta),
      },
    },
  });
