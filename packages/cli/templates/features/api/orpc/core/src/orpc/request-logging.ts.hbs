import { toORPCError } from "@orpc/client";

import { CLIENT_IP_HEADER } from "@/lib/client-ip";
import { logger } from "@/lib/logger";

const BAD_REQUEST_STATUS = 400;
const UNAUTHORIZED_STATUS = 401;
const FORBIDDEN_STATUS = 403;
const TOO_MANY_REQUESTS_STATUS = 429;
const SERVER_ERROR_STATUS = 500;

const REJECTED_REQUEST_STATUSES = new Set([
  BAD_REQUEST_STATUS,
  UNAUTHORIZED_STATUS,
  FORBIDDEN_STATUS,
  TOO_MANY_REQUESTS_STATUS,
]);

export const logProcedureFailure = (error: unknown) => {
  if (toORPCError(error).status < SERVER_ERROR_STATUS) return;
  logger.error({ err: error }, "oRPC procedure failed");
};

export const logRejectedRequest = (status: number, headers: Headers) => {
  if (!REJECTED_REQUEST_STATUSES.has(status)) return;
  logger.warn(
    { status, ip: headers.get(CLIENT_IP_HEADER) },
    "oRPC request rejected",
  );
};
