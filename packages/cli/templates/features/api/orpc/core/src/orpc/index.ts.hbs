import "server-only";

import { ORPCError, os } from "@orpc/server";

{{#if (eq auth "better-auth")}}
import { auth } from "@/lib/auth";
{{/if}}
import { DomainError, type DomainErrorKind } from "@/lib/domain-error";

const ERROR_CODE_BY_KIND = {
  invalid: "BAD_REQUEST",
  "not-found": "NOT_FOUND",
  conflict: "CONFLICT",
  forbidden: "FORBIDDEN",
} satisfies Record<DomainErrorKind, string>;

const base = os.$context<{ headers: Headers }>();

const mapDomainErrors = base.middleware(async ({ next }) => {
  try {
    return await next();
  } catch (error) {
    if (!(error instanceof DomainError)) throw error;
    throw new ORPCError(ERROR_CODE_BY_KIND[error.kind], {
      message: error.code,
      cause: error,
    });
  }
});

export const publicProcedure = base.use(mapDomainErrors);
{{#if (eq auth "better-auth")}}

const requireSession = base.middleware(async ({ context, next }) => {
  const session = await auth.api.getSession({ headers: context.headers });

  if (!session) {
    throw new ORPCError("UNAUTHORIZED");
  }

  return next({ context: { session } });
});

export const protectedProcedure = publicProcedure.use(requireSession);
{{/if}}
