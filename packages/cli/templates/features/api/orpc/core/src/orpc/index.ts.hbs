import "server-only";

import { os } from "@orpc/server";

{{#if (eq auth "better-auth")}}
import { auth } from "@/lib/auth";
import { commonErrors } from "@/lib/errors/common-errors";
{{/if}}
import { toORPCError } from "@/orpc/to-orpc-error";

const base = os.$context<{ headers: Headers }>();

// On the base procedure, so server-side calls and tests get the same errors as
// the HTTP handlers.
const errorMiddleware = base.middleware(async ({ next }) => {
  try {
    return await next();
  } catch (error) {
    throw toORPCError(error);
  }
});

export const publicProcedure = base.use(errorMiddleware);
{{#if (eq auth "better-auth")}}

const requireSession = base.middleware(async ({ context, next }) => {
  const session = await auth.api.getSession({ headers: context.headers });

  if (!session) {
    throw commonErrors.create("UNAUTHORIZED");
  }

  return next({ context: { session } });
});

export const protectedProcedure = publicProcedure.use(requireSession);
{{/if}}
