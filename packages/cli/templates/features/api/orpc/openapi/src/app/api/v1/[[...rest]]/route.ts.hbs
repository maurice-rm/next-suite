import { STATUS_CODES } from "node:http";

{{#unless api.openapi.scalar}}
import { OpenAPIGenerator } from "@orpc/openapi";
{{/unless}}
import { OpenAPIHandler } from "@orpc/openapi/fetch";
{{#if api.openapi.scalar}}
import { OpenAPIReferencePlugin } from "@orpc/openapi/plugins";
{{/if}}
import { onError, type ORPCError } from "@orpc/server";
import { ZodToJsonSchemaConverter } from "@orpc/zod/zod4";

import { logProcedureFailure, logRejectedRequest } from "@/orpc/request-logging";
import { appRouter } from "@/orpc/routers/app-router";

const API_PREFIX = "/api/v1";
const API_VERSION = "1.0.0";
const PROBLEM_CONTENT_TYPE = "application/problem+json";
const NOT_FOUND_STATUS = 404;

const SPEC_INFO = {
  info: { title: "{{projectName}} API", version: API_VERSION },
  servers: [{ url: API_PREFIX }],
};

type ProblemDetails = {
  type: string;
  title: string;
  status: number;
  detail: string;
  code?: string;
  errors?: unknown;
};

const toProblemDetails = (
  error: ORPCError<string, unknown>,
): ProblemDetails => ({
  type: "about:blank",
  title: STATUS_CODES[error.status] ?? error.code,
  status: error.status,
  detail: error.message,
  code: error.code,
  ...(error.data !== undefined && { errors: error.data }),
});

const handler = new OpenAPIHandler(appRouter, {
{{#if api.openapi.scalar}}
  plugins: [
    new OpenAPIReferencePlugin({
      schemaConverters: [new ZodToJsonSchemaConverter()],
      specGenerateOptions: SPEC_INFO,
    }),
  ],
{{/if}}
  customErrorResponseBodyEncoder: toProblemDetails,
  clientInterceptors: [onError(logProcedureFailure)],
});
{{#unless api.openapi.scalar}}

const generator = new OpenAPIGenerator({
  schemaConverters: [new ZodToJsonSchemaConverter()],
});
{{/unless}}

const notFoundResponse = () =>
  Response.json(
    {
      type: "about:blank",
      title: STATUS_CODES[NOT_FOUND_STATUS] ?? "Not Found",
      status: NOT_FOUND_STATUS,
      detail: "No operation matches this path and method.",
    } satisfies ProblemDetails,
    {
      status: NOT_FOUND_STATUS,
      headers: { "Content-Type": PROBLEM_CONTENT_TYPE },
    },
  );

const handleRequest = async (request: Request) => {
  const { matched, response } = await handler.handle(request, {
    prefix: API_PREFIX,
    context: { headers: request.headers },
  });

  if (matched) {
    logRejectedRequest(response.status, request.headers);
    if (!response.ok) response.headers.set("Content-Type", PROBLEM_CONTENT_TYPE);
    return response;
  }
{{#unless api.openapi.scalar}}

  if (new URL(request.url).pathname === `${API_PREFIX}/spec.json`) {
    return Response.json(await generator.generate(appRouter, SPEC_INFO));
  }
{{/unless}}

  return notFoundResponse();
};

export {
  handleRequest as DELETE,
  handleRequest as GET,
  handleRequest as HEAD,
  handleRequest as PATCH,
  handleRequest as POST,
  handleRequest as PUT,
};
