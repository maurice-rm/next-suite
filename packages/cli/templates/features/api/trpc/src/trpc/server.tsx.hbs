import "server-only";

import { cache, type ReactNode } from "react";

import {
  dehydrate,
  type FetchInfiniteQueryOptions,
  type FetchQueryOptions,
  HydrationBoundary,
  type QueryKey,
} from "@tanstack/react-query";
import { createTRPCOptionsProxy } from "@trpc/tanstack-react-query";

import { createTRPCContext } from "@/trpc";
import { createQueryClient } from "@/trpc/query-client";
import { appRouter } from "@/trpc/routers/app-router";

export const getQueryClient = cache(createQueryClient);

export const trpc = createTRPCOptionsProxy({
  ctx: createTRPCContext,
  router: appRouter,
  queryClient: getQueryClient,
});

type HydrateClientProps = { children: ReactNode };

export const HydrateClient = ({ children }: HydrateClientProps) => {
  const state = dehydrate(getQueryClient());
  return <HydrationBoundary state={state}>{children}</HydrationBoundary>;
};

export const prefetch = <
  TQueryFnData,
  TError,
  TData,
  TQueryKey extends QueryKey,
>(
  options: FetchQueryOptions<TQueryFnData, TError, TData, TQueryKey>,
) => {
  void getQueryClient().prefetchQuery(options);
};

export const prefetchInfinite = <
  TQueryFnData,
  TError,
  TData,
  TQueryKey extends QueryKey,
  TPageParam,
>(
  options: FetchInfiniteQueryOptions<
    TQueryFnData,
    TError,
    TData,
    TQueryKey,
    TPageParam
  >,
) => {
  void getQueryClient().prefetchInfiniteQuery(options);
};
