import "server-only";

import { cache } from "react";

import { initTRPC, TRPCError } from "@trpc/server";
import type { TRPC_ERROR_CODE_KEY } from "@trpc/server/rpc";
import superjson from "superjson";
import { z } from "zod";

{{#if (eq auth "better-auth")}}
import { getSession } from "@/lib/auth/session";
{{/if}}
import { AppError } from "@/lib/errors/app-error";
import { commonErrors } from "@/lib/errors/common-errors";
import { toInputInvalidData } from "@/lib/errors/input-invalid-data";
import { HTTP_STATUS, isServerErrorStatus } from "@/lib/http-status";

const UNEXPECTED_ERROR_MESSAGE = "Internal server error";

// tRPC has a fixed set of codes; an app code travels in the error data instead,
// and the tRPC code only carries the status.
const TRPC_CODE_BY_STATUS: Partial<Record<number, TRPC_ERROR_CODE_KEY>> = {
  [HTTP_STATUS.BAD_REQUEST]: "BAD_REQUEST",
  [HTTP_STATUS.UNAUTHORIZED]: "UNAUTHORIZED",
  [HTTP_STATUS.FORBIDDEN]: "FORBIDDEN",
  [HTTP_STATUS.NOT_FOUND]: "NOT_FOUND",
  [HTTP_STATUS.CONFLICT]: "CONFLICT",
  [HTTP_STATUS.TOO_MANY_REQUESTS]: "TOO_MANY_REQUESTS",
  [HTTP_STATUS.INTERNAL_SERVER_ERROR]: "INTERNAL_SERVER_ERROR",
};

const toTRPCCode = (status: number): TRPC_ERROR_CODE_KEY =>
  TRPC_CODE_BY_STATUS[status] ??
  (isServerErrorStatus(status) ? "INTERNAL_SERVER_ERROR" : "BAD_REQUEST");

{{#if (eq auth "better-auth")}}
export const createTRPCContext = cache(async () => ({
  session: await getSession(),
}));
{{else}}
export const createTRPCContext = cache(
  (): Promise<Record<string, never>> => Promise.resolve({}),
);
{{/if}}

export type Context = Awaited<ReturnType<typeof createTRPCContext>>;

const t = initTRPC.context<Context>().create({
  transformer: superjson,
  errorFormatter: ({ shape, error }) => {
    const appError = error.cause instanceof AppError ? error.cause : undefined;
    return {
      ...shape,
      message:
        error.code === "INTERNAL_SERVER_ERROR"
          ? UNEXPECTED_ERROR_MESSAGE
          : shape.message,
      data: {
        ...shape.data,
        code: appError?.code ?? shape.data.code,
        ...(appError?.data !== undefined && { data: appError.data }),
      },
    };
  },
});

const toAppError = (error: TRPCError) => {
  if (error.cause instanceof AppError) return error.cause;
  if (error.code === "BAD_REQUEST" && error.cause instanceof z.ZodError) {
    return commonErrors.create("INPUT_INVALID", {
      data: toInputInvalidData(error.cause.issues),
      cause: error,
    });
  }
  return undefined;
};

// On the base procedure, so server-side callers and tests get the same errors
// as the HTTP handler.
const errorMiddleware = t.middleware(async ({ next }) => {
  const result = await next();
  if (result.ok) return result;
  const appError = toAppError(result.error);
  if (!appError) return result;
  throw new TRPCError({
    code: toTRPCCode(appError.status),
    message: appError.message,
    cause: appError,
  });
});

export const router = t.router;
export const createCallerFactory = t.createCallerFactory;
export const publicProcedure = t.procedure.use(errorMiddleware);
{{#if (eq auth "better-auth")}}

const requireSession = t.middleware(({ ctx, next }) => {
  if (!ctx.session) {
    throw commonErrors.create("UNAUTHORIZED");
  }
  return next({ ctx: { session: ctx.session } });
});

export const protectedProcedure = publicProcedure.use(requireSession);
{{/if}}
