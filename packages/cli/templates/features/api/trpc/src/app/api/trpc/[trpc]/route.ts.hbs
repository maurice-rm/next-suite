import { fetchRequestHandler } from "@trpc/server/adapters/fetch";
import { getHTTPStatusCodeFromError } from "@trpc/server/http";

import { CLIENT_IP_HEADER } from "@/lib/client-ip";
import { logger } from "@/lib/logger";
import { createTRPCContext } from "@/trpc";
import { TRPC_ENDPOINT } from "@/trpc/endpoint";
import { appRouter } from "@/trpc/routers/app-router";

const SERVER_ERROR_STATUS = 500;

const REJECTED_REQUEST_CODES = new Set([
  "BAD_REQUEST",
  "UNAUTHORIZED",
  "FORBIDDEN",
  "TOO_MANY_REQUESTS",
]);

const handler = (request: Request) =>
  fetchRequestHandler({
    endpoint: TRPC_ENDPOINT,
    req: request,
    router: appRouter,
    createContext: createTRPCContext,
    onError: ({ error, path{{#if (eq auth "better-auth")}}, ctx{{/if}} }) => {
      if (getHTTPStatusCodeFromError(error) >= SERVER_ERROR_STATUS) {
        logger.error({ err: error, path }, "tRPC procedure failed");
        return;
      }
      if (!REJECTED_REQUEST_CODES.has(error.code)) return;
      logger.warn(
        {
          code: error.code,
          path,
{{#if (eq auth "better-auth")}}
          userId: ctx?.session?.user.id,
{{/if}}
          ip: request.headers.get(CLIENT_IP_HEADER),
        },
        "tRPC request rejected",
      );
    },
  });

export { handler as GET, handler as POST };
