name: CI

on:
  pull_request:
{{#unless (and production (hasCdStep githubActions))}}
  push:
    branches: [main]
{{/unless}}
  workflow_call:

permissions:
  contents: read

concurrency:
  group: ci-$\{{ github.ref }}
  cancel-in-progress: true

jobs:
  ci:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      SKIP_ENV_VALIDATION: "true"
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/setup
{{#if (includes githubActions "lint")}}
      - name: Lint
        run: {{packageManager}} run lint
{{/if}}
{{#if (includes githubActions "typecheck")}}
      - name: Type-check
        run: {{packageManager}} run typecheck
{{/if}}
{{#if (includes githubActions "format")}}
      - name: Format check
        run: {{packageManager}} run format:check
{{/if}}
{{#if (includes githubActions "build")}}
{{#if (or api (eq auth "better-auth"))}}
      - name: Require NEXT_PUBLIC_APP_URL
        env:
          APP_URL: $\{{ vars.NEXT_PUBLIC_APP_URL }}
        run: |
          [ -n "$APP_URL" ] || {
            echo "Repository variable NEXT_PUBLIC_APP_URL is unset — run 'next-suite provision' before building." >&2
            exit 1
          }
{{/if}}
      - name: Build
        run: {{packageManager}} run build
        env: $\{{ vars }}
{{/if}}