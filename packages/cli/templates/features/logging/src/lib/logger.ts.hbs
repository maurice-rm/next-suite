import "server-only";

import pino from "pino";

import { env } from "@/env";

const SECRET_FIELDS = [
  "password",
  "token",
  "accessToken",
  "refreshToken",
  "idToken",
  "secret",
  "cookie",
  "authorization",
];

const REDACTED_PATHS = [
  ...SECRET_FIELDS,
  ...SECRET_FIELDS.map((field) => `*.${field}`),
  "*.headers.cookie",
  "*.headers.authorization",
  '*.headers["set-cookie"]',
];

// Drizzle appends the bound values of a failed query to the error message
// (`params: ${params}`), where key-based redaction cannot reach them; the
// exact text is rebuilt from the error so multi-line values go too.
const REDACTED_PARAMS = "params: [Redacted]";

const collectQueryParams = (error: unknown): string[] => {
  const found: string[] = [];
  let current: unknown = error;
  while (current instanceof Error) {
    if ("params" in current && Array.isArray(current.params)) {
      found.push(`params: ${String(current.params)}`);
    }
    current = current.cause;
  }
  return found;
};

const redactQueryParams = (
  text: string | undefined,
  queryParams: string[],
): string | undefined =>
  queryParams.reduce(
    (redacted, params) => redacted?.split(params).join(REDACTED_PARAMS),
    text,
  );

const serializeError = (error: unknown) => {
  if (!(error instanceof Error)) return error;
  const queryParams = collectQueryParams(error);
  const serialized = pino.stdSerializers.err(error);
  return {
    ...serialized,
    message: redactQueryParams(serialized.message, queryParams),
    stack: redactQueryParams(serialized.stack, queryParams),
    ...("params" in serialized && { params: "[Redacted]" }),
  };
};

export const logger = pino({
  level: env.NODE_ENV === "production" ? "info" : "debug",
  redact: REDACTED_PATHS,
  serializers: { err: serializeError },
  ...(env.NODE_ENV === "development" && {
    transport: { target: "pino-pretty" },
  }),
});
