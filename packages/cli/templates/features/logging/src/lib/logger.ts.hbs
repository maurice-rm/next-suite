import "server-only";

import pino from "pino";

import { env } from "@/env";

const SECRET_FIELDS = [
  "password",
  "token",
  "accessToken",
  "refreshToken",
  "idToken",
  "secret",
  "cookie",
  "authorization",
];

const REDACTED_PATHS = [
  ...SECRET_FIELDS,
  ...SECRET_FIELDS.map((field) => `*.${field}`),
  "*.headers.cookie",
  "*.headers.authorization",
  '*.headers["set-cookie"]',
];

// Drizzle appends the bound values of a failed query to the error message
// (`params: ${params}`), where key-based redaction cannot reach them; the
// exact text is rebuilt from the error so multi-line values go too, also in
// nested and aggregated errors.
const REDACTED_PARAMS = "params: [Redacted]";

const isQueryError = (error: Error): error is Error & { params: unknown[] } =>
  "params" in error && Array.isArray(error.params);

// Walks causes, aggregated errors and Error-valued fields, each once: a cyclic
// chain must not hang the logger.
const collectQueryParams = (error: Error): string[] => {
  const found: string[] = [];
  const seen = new Set<Error>();
  const pending: unknown[] = [error];
  while (pending.length > 0) {
    const current = pending.pop();
    if (!(current instanceof Error) || seen.has(current)) continue;
    seen.add(current);
    if (isQueryError(current)) found.push(`params: ${String(current.params)}`);
    const fields: unknown[] = Object.values(current);
    const aggregated: unknown[] =
      current instanceof AggregateError ? current.errors : [];
    pending.push(current.cause, ...fields, ...aggregated);
  }
  return found;
};

type RedactionContext = {
  queryParams: string[];
  seen: WeakSet<object>;
  errorPrototype: unknown;
};

// Only the serializer's own output is walked: plain objects, arrays and the
// serialized errors; class instances (Date, Buffer, sockets) pass untouched.
const isWalkable = (
  value: object,
  errorPrototype: unknown,
): value is Record<string, unknown> => {
  const prototype: unknown = Object.getPrototypeOf(value);
  return (
    prototype === Object.prototype ||
    prototype === null ||
    prototype === errorPrototype
  );
};

const redactSerialized = (
  value: unknown,
  context: RedactionContext,
): unknown => {
  if (typeof value === "string") {
    return context.queryParams.reduce(
      (redacted, params) => redacted.split(params).join(REDACTED_PARAMS),
      value,
    );
  }
  if (value === null || typeof value !== "object") return value;
  if (context.seen.has(value)) return "[Circular]";
  if (Array.isArray(value)) {
    context.seen.add(value);
    return value.map((item) => redactSerialized(item, context));
  }
  if (!isWalkable(value, context.errorPrototype)) return value;
  context.seen.add(value);
  return Object.fromEntries(
    Object.entries(value).map(([key, field]) => [
      key,
      key === "params" ? "[Redacted]" : redactSerialized(field, context),
    ]),
  );
};

const serializeError = (error: unknown) => {
  if (!(error instanceof Error)) return error;
  const serialized = pino.stdSerializers.err(error);
  return redactSerialized(serialized, {
    queryParams: collectQueryParams(error),
    seen: new WeakSet(),
    errorPrototype: Object.getPrototypeOf(serialized),
  });
};

export const logger = pino({
  level: env.NODE_ENV === "production" ? "info" : "debug",
  redact: REDACTED_PATHS,
  serializers: { err: serializeError },
  ...(env.NODE_ENV === "development" && {
    transport: { target: "pino-pretty" },
  }),
});
