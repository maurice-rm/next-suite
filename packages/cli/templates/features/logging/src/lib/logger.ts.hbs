import "server-only";

import pino from "pino";

import { env } from "@/env";

const SECRET_FIELDS = [
  "password",
  "token",
  "accessToken",
  "refreshToken",
  "idToken",
  "secret",
  "cookie",
  "authorization",
];

const REDACTED_PATHS = [
  ...SECRET_FIELDS,
  ...SECRET_FIELDS.map((field) => `*.${field}`),
  "*.headers.cookie",
  "*.headers.authorization",
  '*.headers["set-cookie"]',
];

// Drizzle appends the bound values of a failed query to the error message,
// where key-based redaction cannot reach them.
const QUERY_PARAMS_LINE = /\nparams: .*/g;
const REDACTED_PARAMS_LINE = "\nparams: [Redacted]";

const redactQueryParams = (text: string | undefined) =>
  text?.replace(QUERY_PARAMS_LINE, REDACTED_PARAMS_LINE);

const serializeError = (error: unknown) => {
  if (!(error instanceof Error)) return error;
  const serialized = pino.stdSerializers.err(error);
  return {
    ...serialized,
    message: redactQueryParams(serialized.message),
    stack: redactQueryParams(serialized.stack),
    ...("params" in serialized && { params: "[Redacted]" }),
  };
};

export const logger = pino({
  level: env.NODE_ENV === "production" ? "info" : "debug",
  redact: REDACTED_PATHS,
  serializers: { err: serializeError },
  ...(env.NODE_ENV === "development" && {
    transport: { target: "pino-pretty" },
  }),
});
