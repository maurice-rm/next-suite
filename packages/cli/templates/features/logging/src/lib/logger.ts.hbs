import "server-only";

import pino from "pino";

import { env } from "@/env";

const SECRET_FIELDS = [
  "password",
  "token",
  "accessToken",
  "refreshToken",
  "idToken",
  "secret",
  "cookie",
  "authorization",
];

const REDACTED_PATHS = [
  ...SECRET_FIELDS,
  ...SECRET_FIELDS.map((field) => `*.${field}`),
  "*.headers.cookie",
  "*.headers.authorization",
  '*.headers["set-cookie"]',
];

// Drizzle appends the bound values of a failed query to the error message
// (`params: ${params}`), where key-based redaction cannot reach them. The exact
// text is rebuilt from every query error reachable from the logged one, so
// multi-line values and nested or aggregated errors are covered too.
const REDACTED = "[Redacted]";
const REDACTED_PARAMS = `params: ${REDACTED}`;
const CIRCULAR = "[Circular]";

const isQueryError = (error: Error): error is Error & { params: unknown[] } =>
  "params" in error && Array.isArray(error.params);

const isPlainObject = (value: object): value is Record<string, unknown> => {
  const prototype: unknown = Object.getPrototypeOf(value);
  return prototype === Object.prototype || prototype === null;
};

const listChildren = (value: object): unknown[] => {
  if (Array.isArray(value)) return value;
  if (isPlainObject(value)) return Object.values(value);
  if (!(value instanceof Error)) return [];
  const fields: unknown[] = Object.values(value);
  const aggregated: unknown[] =
    "errors" in value && Array.isArray(value.errors) ? value.errors : [];
  return [value.cause, ...fields, ...aggregated];
};

// Visits each object once, so a cyclic graph ends.
const collectQueryParams = (root: Error): string[] => {
  const found: string[] = [];
  const seen = new WeakSet<object>();
  const pending: unknown[] = [root];
  while (pending.length > 0) {
    const current = pending.pop();
    if (current === null || typeof current !== "object") continue;
    if (seen.has(current)) continue;
    seen.add(current);
    if (current instanceof Error && isQueryError(current)) {
      found.push(`params: ${String(current.params)}`);
    }
    pending.push(...listChildren(current));
  }
  return found;
};

type RedactionContext = {
  queryParams: string[];
  ancestors: Set<object>;
  errorPrototype: unknown;
};

const redactText = (text: string, queryParams: string[]): string =>
  queryParams.reduce(
    (redacted, params) => redacted.split(params).join(REDACTED_PARAMS),
    text,
  );

// Walks plain objects, arrays and serialized errors; class instances (Date,
// Buffer, sockets) pass untouched. Cycles are cut along the current path only.
const isWalkable = (value: object, errorPrototype: unknown): boolean =>
  Array.isArray(value) ||
  isPlainObject(value) ||
  Object.getPrototypeOf(value) === errorPrototype;

const walkChildren = (value: object, context: RedactionContext): unknown => {
  if (Array.isArray(value)) {
    return value.map((item) => redactValue(item, context));
  }
  return Object.fromEntries(
    Object.entries(value).map(([key, field]) => [
      key,
      key === "params" ? REDACTED : redactValue(field, context),
    ]),
  );
};

const redactValue = (value: unknown, context: RedactionContext): unknown => {
  if (typeof value === "string") return redactText(value, context.queryParams);
  if (value === null || typeof value !== "object") return value;
  if (context.ancestors.has(value)) return CIRCULAR;
  const isError = value instanceof Error;
  if (!isError && !isWalkable(value, context.errorPrototype)) return value;
  context.ancestors.add(value);
  const redacted = walkChildren(
    isError ? pino.stdSerializers.err(value) : value,
    context,
  );
  context.ancestors.delete(value);
  return redacted;
};

const serializeError = (error: unknown) => {
  if (!(error instanceof Error)) return error;
  return redactValue(error, {
    queryParams: collectQueryParams(error),
    ancestors: new Set(),
    errorPrototype: Object.getPrototypeOf(pino.stdSerializers.err(error)),
  });
};

export const logger = pino({
  level: env.NODE_ENV === "production" ? "info" : "debug",
  redact: REDACTED_PATHS,
  serializers: { err: serializeError },
  ...(env.NODE_ENV === "development" && {
    transport: { target: "pino-pretty" },
  }),
});
