import "dotenv/config";

import { defineConfig } from "prisma/config";

{{#if (eq database.engine "postgres")}}
const url = `postgresql://${process.env.POSTGRES_USER}:${process.env.POSTGRES_PASSWORD}@${process.env.POSTGRES_HOST}:${process.env.POSTGRES_PORT}/${process.env.POSTGRES_DATABASE}`;
{{else}}
const url = `mysql://${process.env.MYSQL_USER}:${process.env.MYSQL_PASSWORD}@${process.env.MYSQL_HOST}:${process.env.MYSQL_PORT}/${process.env.MYSQL_DATABASE}`;
{{/if}}

export default defineConfig({
  schema: "prisma/",
  datasource: {
    url,
  },
});