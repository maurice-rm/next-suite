import "dotenv/config";

import { defineConfig } from "prisma/config";

const urlPart = (value: string | undefined) => encodeURIComponent(value ?? "");

{{#if (eq database.engine "postgres")}}
const url = `postgresql://${urlPart(process.env.POSTGRES_USER)}:${urlPart(process.env.POSTGRES_PASSWORD)}@${urlPart(process.env.POSTGRES_HOST)}:${urlPart(process.env.POSTGRES_PORT)}/${urlPart(process.env.POSTGRES_DATABASE)}`;
{{else}}
const url = `mysql://${urlPart(process.env.MYSQL_USER)}:${urlPart(process.env.MYSQL_PASSWORD)}@${urlPart(process.env.MYSQL_HOST)}:${urlPart(process.env.MYSQL_PORT)}/${urlPart(process.env.MYSQL_DATABASE)}`;
{{/if}}

export default defineConfig({
  schema: "prisma/",
  datasource: {
    url,
  },
});
