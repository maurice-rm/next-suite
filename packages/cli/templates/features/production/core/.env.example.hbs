COMPOSE_PROJECT_NAME={{projectName}}
{{#if (eq production.mode "proxied")}}

# Loopback port of the nginx sidecar; must match the host's proxy_pass. See DEPLOY.md.
APP_PORT=8100
{{/if}}

# Production image for docker-compose.prod.yml. Leave unset to build locally;
# set to ghcr.io/OWNER/REPO:TAG to pull a prebuilt image instead.
DOCKER_IMAGE=
