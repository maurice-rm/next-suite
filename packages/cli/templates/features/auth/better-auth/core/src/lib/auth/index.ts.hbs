import "server-only";

{{#if (eq database.orm "drizzle")}}
import { drizzleAdapter } from "better-auth/adapters/drizzle";
{{else}}
import { prismaAdapter } from "better-auth/adapters/prisma";
{{/if}}
import { betterAuth } from "better-auth/minimal";
import { nextCookies } from "better-auth/next-js";

import { env } from "@/env";
import { forwardAuthLog } from "@/lib/auth/logging/forward-auth-log";
import { CLIENT_IP_HEADER } from "@/lib/client-ip";
import { database } from "@/lib/database";
{{#if (eq database.orm "drizzle")}}
import { account, session, user, verification } from "@/lib/database/schema";
{{/if}}

export const auth = betterAuth({
  baseURL: env.NEXT_PUBLIC_APP_URL,
  secret: env.BETTER_AUTH_SECRET,
{{#if (eq database.orm "drizzle")}}
  database: drizzleAdapter(database, {
    provider: "{{#if (eq database.engine "postgres")}}pg{{else}}mysql{{/if}}",
    schema: { account, session, user, verification },
  }),
{{else}}
  database: prismaAdapter(database, {
    provider: "{{#if (eq database.engine "postgres")}}postgresql{{else}}mysql{{/if}}",
  }),
{{/if}}
  emailAndPassword: {
    enabled: true,
  },
  advanced: {
    ipAddress: { ipAddressHeaders: [CLIENT_IP_HEADER] },
  },
  logger: { log: forwardAuthLog },
  plugins: [nextCookies()],
});
