"use client";

type ErrorPageProps = {
  error: Error & { digest?: string };
  retry: () => void;
};

const ErrorPage = ({ retry }: ErrorPageProps) => (
  <main>
    <h1>Something went wrong</h1>
    <button type="button" onClick={retry}>
      Try again
    </button>
  </main>
);

export default ErrorPage;
