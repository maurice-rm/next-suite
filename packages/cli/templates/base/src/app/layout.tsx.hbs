import "./globals.css";
{{#if (eq api.type "orpc")}}
import "@/orpc/client.server";
{{/if}}

import type { Metadata, Viewport } from "next";
import type { ReactNode } from "react";
{{#unless shadcn}}
import { Geist, Geist_Mono } from "next/font/google";
{{/unless}}
{{#if (or api (eq auth "better-auth"))}}

{{#if api}}
import { Toaster } from "sonner";

import { Providers } from "@/app/providers";
{{/if}}
import { env } from "@/env";
{{/if}}
{{#unless shadcn}}

const geistSans = Geist({
  variable: "--font-geist-sans",
  subsets: ["latin"],
});

const geistMono = Geist_Mono({
  variable: "--font-geist-mono",
  subsets: ["latin"],
});
{{/unless}}

export const metadata: Metadata = {
{{#if (or api (eq auth "better-auth"))}}
  metadataBase: URL.parse(env.NEXT_PUBLIC_APP_URL),
{{/if}}
  title: {
    default: "{{projectName}}",
    template: "%s · {{projectName}}",
  },
  description: "{{projectName}}, a Next.js application.",
};

{{#if shadcn}}
// shadcn's dark theme follows a `.dark` class that nothing sets yet.
export const viewport: Viewport = {
  themeColor: "#ffffff",
};
{{else}}
export const viewport: Viewport = {
  themeColor: [
    { media: "(prefers-color-scheme: light)", color: "#ffffff" },
    { media: "(prefers-color-scheme: dark)", color: "#0a0a0a" },
  ],
};
{{/if}}

type RootLayoutProps = Readonly<{ children: ReactNode }>;

const RootLayout = ({ children }: RootLayoutProps) => (
{{#if shadcn}}
  <html lang="en">
{{else}}
  <html lang="en" className={`${geistSans.variable} ${geistMono.variable}`}>
{{/if}}
{{#if api}}
    <body>
      <Providers>{children}</Providers>
      <Toaster{{#unless shadcn}} theme="system"{{/unless}} />
    </body>
{{else}}
    <body>{children}</body>
{{/if}}
  </html>
);

export default RootLayout;
