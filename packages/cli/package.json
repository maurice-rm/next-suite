{
  "name": "create-next-suite",
  "version": "1.0.2",
  "description": "A better starting point for Next.js — an interactive CLI that scaffolds Next.js projects.",
  "keywords": [
    "nextjs",
    "next",
    "scaffold",
    "scaffolding",
    "cli",
    "create",
    "create-next-app",
    "boilerplate",
    "starter",
    "starter-kit",
    "template",
    "generator",
    "turborepo",
    "typescript"
  ],
  "homepage": "https://github.com/maurice-rm/next-suite#readme",
  "bugs": {
    "url": "https://github.com/maurice-rm/next-suite/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maurice-rm/next-suite.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Maurice Reim (https://github.com/maurice-rm)",
  "type": "module",
  "bin": {
    "create-next-suite": "./dist/index.js",
    "next-suite": "./dist/suite.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "deps:check": "tsx scripts/check-deps.ts",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "matrix": "tsx scripts/matrix.ts",
    "prepublishOnly": "pnpm run build && publint",
    "test": "vitest run",
    "test:update": "vitest run -u",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "ansis": "^4.3.1",
    "citty": "^0.2.2",
    "execa": "^10.0.0",
    "fs-extra": "^11.4.0",
    "handlebars": "^4.7.9",
    "validate-npm-package-name": "^8.0.0"
  },
  "devDependencies": {
    "@next-suite/eslint-config": "workspace:*",
    "@next-suite/typescript-config": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "catalog:",
    "@types/validate-npm-package-name": "^4.0.2",
    "eslint": "catalog:",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
