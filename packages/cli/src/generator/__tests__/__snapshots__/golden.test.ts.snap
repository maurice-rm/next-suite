=== next.Dockerfile ===
# ============================================
# Stage 1: Install dependencies
# ============================================

ARG NODE_VERSION=24-slim

FROM node:\${NODE_VERSION} AS dependencies

WORKDIR /app

# Prisma's postinstall (prisma generate) needs the schema + config at install time.
COPY prisma ./prisma
COPY prisma.config.ts ./prisma.config.ts

COPY package.json bun.lock ./
RUN --mount=type=cache,target=/root/.bun/install/cache \\
  npm install -g bun && bun install --frozen-lockfile

# ============================================
# Stage 2: Build the Next.js application
# ============================================

FROM node:\${NODE_VERSION} AS builder

WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
# Reuse the client the deps stage generated (schema output: src/generated/prisma).
COPY --from=dependencies /app/src/generated ./src/generated

ENV SKIP_ENV_VALIDATION=true

ARG NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL

RUN npm install -g bun && bun run build

# ============================================
# Stage 3: Run the Next.js application
# ============================================

FROM node:\${NODE_VERSION} AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# curl for the app healthcheck; the DB client for the entrypoint's readiness check; OpenSSL for Prisma's engines — node:slim omits these.
RUN apt-get update && apt-get install -y --no-install-recommends \\
  curl \\
  default-mysql-client \\
  openssl \\
  && rm -rf /var/lib/apt/lists/*

# Copy production assets
COPY --from=builder --chown=node:node /app/public ./public

# Set the correct permission for the prerender cache
RUN mkdir .next && chown node:node .next

# Copy standalone output and static files
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static

# Migration tooling (applied on start by entrypoint.sh)
# prisma migrate deploy needs the full CLI + engines + transitive deps (not
# traced into standalone), so the complete node_modules is copied, per the
# Prisma Docker guide. The schema + config supply the connection URL.
COPY --from=builder --chown=node:node /app/prisma ./prisma
COPY --from=builder --chown=node:node /app/prisma.config.ts ./prisma.config.ts
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/entrypoint.sh ./entrypoint.sh
RUN chmod +x ./entrypoint.sh

USER node

EXPOSE 3000

ENTRYPOINT ["./entrypoint.sh"]


=== next.config.ts ===
import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  /* config options here */
  poweredByHeader: false,
  output: "standalone",
  experimental: {
    serverActions: { bodySizeLimit: "25mb" },
  },
  reactCompiler: true,
  typedRoutes: true,
};

export default nextConfig;


=== nginx/nginx.conf ===
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include      /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile    on;
    tcp_nopush  on;
    tcp_nodelay on;
    server_tokens off;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;
    error_log  /var/log/nginx/error.log warn;

    client_max_body_size  25m;
    client_header_timeout 15s;
    client_body_timeout   30s;
    send_timeout          30s;
    keepalive_timeout     65s;

    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    120s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      "";
    }

    # Fail safe: a proxy omitting X-Forwarded-Proto must not downgrade the app.
    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ''      https;
    }

    # Without resolve+zone nginx caches app's IP from startup and 502s forever.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream app {
        zone   upstream_app 64k;
        server app:3000 resolve;
        keepalive 32;
    }

    # No gzip: the Next.js server compresses its own responses.

    ssl_protocols            TLSv1.2 TLSv1.3;
    # Mozilla intermediate minus DHE — those need ssl_dhparam, which is not shipped.
    ssl_ciphers              "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305";
    ssl_prefer_server_ciphers off;
    ssl_session_cache        shared:SSL:10m;
    ssl_session_timeout      1d;
    ssl_session_tickets      off;

    limit_req_zone $binary_remote_addr zone=app:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=assets:10m rate=100r/s;
    limit_req_status 429;

    # Bare IP, unknown SNI, foreign domains — without these the site below
    # would answer them with an attacker-chosen Host header.
    server {
        listen      80 default_server;
        listen      [::]:80 default_server;
        server_name _;
        return 444;
    }

    server {
        listen 443 ssl default_server;
        listen [::]:443 ssl default_server;
        ssl_reject_handshake on;
        return 444;
    }

    server {
        listen      80;
        listen      [::]:80;
        server_name example.com www.example.com; # TODO: set your domain

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen      443 ssl;
        listen      [::]:443 ssl;
        http2       on;
        server_name example.com www.example.com; # TODO: set your domain

        ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem; # TODO: set your certificate path
        ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem; # TODO: set your certificate path

        # Any location that sets its own add_header drops all of these.
        # No includeSubDomains: a 3-label name can still be an apex (co.uk), and
        # guessing wrong pins the zone for two years. Add it by hand if it applies.
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Content-Type-Options    "nosniff"                         always;
        add_header X-Frame-Options           "SAMEORIGIN"                      always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy        "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()" always;
        add_header Cross-Origin-Opener-Policy        "same-origin-allow-popups" always;
        add_header Cross-Origin-Resource-Policy      "same-origin"              always;
        add_header X-Permitted-Cross-Domain-Policies "none"                     always;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_buffering off;

        location /_next/static/ {
            proxy_pass http://app;
        }

        # Sibling of /_next/static/, not a child — would otherwise hit location /.
        location /_next/image {
            limit_req zone=assets burst=100 nodelay;
            proxy_pass http://app;
        }

        location / {
            limit_req zone=app burst=50 nodelay;
            proxy_pass http://app;
        }
    }
}


