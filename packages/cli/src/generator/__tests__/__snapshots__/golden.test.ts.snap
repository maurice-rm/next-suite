        "error",
        {
          groups: [
            ["^\\\\u0000"],
            ["^node:"],
            ["^react", "^next"],
            ["^@?\\\\w"],
            ["^@/"],
            ["^"],
            ["^\\\\."],
          ],
        },
      ],
      "simple-import-sort/exports": "error",
      "import/first": "error",
      "import/newline-after-import": "error",
      "import/no-duplicates": "error",
      "no-console": ["warn", { allow: ["warn", "error"] }],
    },
  },
  prettier,
]);

export default eslintConfig;


