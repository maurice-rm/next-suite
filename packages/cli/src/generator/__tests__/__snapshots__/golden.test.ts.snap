=== src/lib/database/index.ts ===
import { PrismaPg } from "@prisma/adapter-pg";

import { env } from "@/env";
import { PrismaClient } from "@/generated/prisma/client";

const adapter = new PrismaPg({
  host: env.POSTGRES_HOST,
  port: env.POSTGRES_PORT,
  database: env.POSTGRES_DATABASE,
  user: env.POSTGRES_USER,
  password: env.POSTGRES_PASSWORD,
  max: 20,
  idleTimeoutMillis: 30_000,
  connectionTimeoutMillis: 5_000,
});

// Reuse one client across dev hot-reloads — fresh modules would leak connections.
const globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };

export const database = globalForPrisma.prisma ?? new PrismaClient({ adapter });

if (process.env.NODE_ENV !== "production") globalForPrisma.prisma = database;

export async function closeDatabase() {
  await database.$disconnect();
}

=== src/lib/email/index.ts ===
import { Resend } from "resend";

import { env } from "@/env";

export const EMAIL_FROM = env.EMAIL_FROM;

let instance: Resend | null = null;

// Lazy: instantiating at import breaks builds without secrets
// (e.g. Docker builds running with SKIP_ENV_VALIDATION).
export const resend = new Proxy({} as Resend, {
  get(_, prop) {
    instance ??= new Resend(env.RESEND_API_KEY);
    return Reflect.get(instance, prop);
  },
});


