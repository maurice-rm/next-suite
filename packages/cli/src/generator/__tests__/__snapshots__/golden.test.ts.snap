  server: {
    POSTGRES_PORT: z.coerce.number(),
    POSTGRES_HOST: z.string(),
    POSTGRES_USER: z.string(),
    POSTGRES_PASSWORD: z.string(),
    POSTGRES_DATABASE: z.string(),
    BETTER_AUTH_SECRET: z.string().min(32),
