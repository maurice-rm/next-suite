concurrency:
  group: ci-\${{ github.ref }}
  cancel-in-progress: true

jobs:
  ci:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      SKIP_ENV_VALIDATION: "true"
    steps:
      - uses: actions/checkout@v7
      - uses: ./.github/actions/setup
      - name: Lint
        run: pnpm run lint
      - name: Type-check
        run: pnpm run typecheck
      - name: Format check
        run: pnpm run format:check
      - name: Require NEXT_PUBLIC_APP_URL
        env:
          APP_URL: \${{ vars.NEXT_PUBLIC_APP_URL }}
        run: |
          [ -n "$APP_URL" ] || {
            echo "Repository variable NEXT_PUBLIC_APP_URL is unset — run 'next-suite provision' before building." >&2
            exit 1
          }
      - name: Build
        run: pnpm run build
        env: \${{ vars }}


