=== docker-compose.prod.yml ===
services:
  app:
    image: \${DOCKER_IMAGE:-acme-app:latest}
    build:
      context: .
      dockerfile: next.Dockerfile
    env_file:
      - .env
    expose:
      - "3000"
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:3000/api/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s
    networks:
      - app-network
    restart: always

  nginx:
    image: nginx:1.29-alpine
    depends_on:
      app:
        condition: service_healthy
        restart: true
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
    ports:
      - "127.0.0.1:\${APP_PORT:?APP_PORT is required in .env — see DEPLOY.md}:80"
    networks:
      - app-network
    restart: always

networks:
  app-network:
    driver: bridge


